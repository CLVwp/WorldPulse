// Déploiement Cloudflare : 1 Worker = front statique (export Next.js dans out/)
// + API Hono + Cron + KV.
// 1. bun run kv:create  →  2. coller l'id ci-dessous  →  3. bun run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldpulse",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "triggers": {
    // Budget free tier : le cron écrit 1 fois le snapshot KV à chaque passage.
    // */10 → 144 écrits/jour ≈ 14 % du quota gratuit (1 000 écrits/jour).
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "2f2a8dbcc0df4f4986894d87cbd0864f"
    }
  ]
}
